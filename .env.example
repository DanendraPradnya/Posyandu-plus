# ==============================================================================
# Posyandu+ Environment Variables (.env.example)
# Salin berkas ini menjadi `.env.local` untuk pengembangan lokal.
# JANGAN PERNAH menyimpan kunci API asli di repositori Git!
# ==============================================================================

# 1. Aplikasi Umum
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# 2. Supabase (Database PostgreSQL, Auth, & Storage - Wilayah Singapura)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET_KIA="kia-photos"

# 3. Multimodal LLM & Teks LLM (Ekstraksi Foto KIA & Edukasi Personal)
# Catatan: Gunakan paket berbayar (zero data retention) untuk data nyata.
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_VISION_MODEL="gemini-2.5-flash"
GEMINI_TEXT_MODEL="gemini-2.5-flash"

# Cadangan (Fallback) Ekstraksi & Edukasi (NFR3)
OPENAI_API_KEY="your-openai-api-key"
OPENAI_VISION_MODEL="gpt-4o-mini"

# 4. Anggaran & Batas Biaya LLM (NFR6 & Bab 12.2)
# Batas pengeluaran bulanan dalam USD (otomatis beralih ke input manual pada 100%)
LLM_MONTHLY_BUDGET_USD="4.00"
LLM_BUDGET_WARN_THRESHOLD="0.70"
LLM_RATE_LIMIT_PER_USER_PER_HOUR="30"

# 5. Antrean Job Latar Belakang (Inngest)
INNGEST_EVENT_KEY="local"
INNGEST_SIGNING_KEY=""

# 6. Observabilitas & Pemantauan Galat (Sentry - NFR6)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# 7. Keamanan Tautan Bagikan (FR13)
SHARE_LINK_DEFAULT_EXPIRY_DAYS="30"
SHARE_LINK_TOKEN_PEPPER="ganti-dengan-string-acak-minimal-32-karakter"
